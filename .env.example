# SmartSort Web Dashboard Environment Configuration

# URL Backend SmartSort (Gunakan https://smartsort.ezzar.my.id untuk produksi atau http://localhost:8088 untuk dev lokal)
VITE_API_BASE_URL=https://smartsort.ezzar.my.id

# API Key untuk autentikasi endpoint backend (header X-API-Key)
VITE_API_KEY=your_api_key_here
